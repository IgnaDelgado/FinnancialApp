{
  "expo": {
    "name": "Financial Plan",
    "slug": "financial-plan",
    "scheme": "financial-plan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/financial-plan-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12352F",
        "foregroundImage": "./assets/financial-plan-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/financial-plan-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
